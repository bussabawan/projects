# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# upload
/uploads/*
!/uploads/audio/
!/uploads/images/
!/uploads/.gitkeep

/uploads/audio/*
!/uploads/audio/.gitkeep
!/uploads/audio/1787126482588-291944130-tts-1787126482561.mp3

/uploads/images/*
!/uploads/images/.gitkeep
!/uploads/images/1787126481506-55842190-images.png
