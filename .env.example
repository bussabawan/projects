# ==============================================================================
# App Config
# ==============================================================================
# พอร์ตสำหรับรันแอปพลิเคชัน (ค่าเริ่มต้น: 3000)
PORT=3000

# ==============================================================================
# MySQL Config
# ==============================================================================
# รหัสผ่านสำหรับ root ของ MySQL
MYSQL_ROOT_PASSWORD=password

# ชื่อฐานข้อมูลสำหรับโปรเจกต์
MYSQL_DATABASE=ot_project_db

# ชื่อผู้ใช้งานฐานข้อมูล
MYSQL_USER=admin

# รหัสผ่านสำหรับผู้ใช้งานฐานข้อมูล
MYSQL_PASSWORD=password

# โฮสต์ของฐานข้อมูล (ใช้ 'mysql' สำหรับการรันผ่าน Docker)
MYSQL_HOST=mysql

# พอร์ตของฐานข้อมูล MySQL (ค่าเริ่มต้น: 3306)
MYSQL_PORT=3306

# คีย์ลับสำหรับ Auth.js ใช้ในการเข้ารหัส JWT และ Sessions
# สามารถสร้างใหม่ด้วยคำสั่ง: npx auth secret หรือ openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# ==============================================================================
# Google OAuth Config
# ==============================================================================
# ข้อมูลสำหรับ Google OAuth (สร้างจาก Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ==============================================================================
# NextAuth Config
# ==============================================================================
# URL หลักของแอปพลิเคชันสำหรับ Auth.js (ในโหมด production ให้ใช้ URL จริงของเว็บ)
AUTH_URL="http://localhost:3000"